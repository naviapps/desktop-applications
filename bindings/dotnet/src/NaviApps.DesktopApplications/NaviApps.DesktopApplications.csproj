<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PackageId>NaviApps.DesktopApplications</PackageId>
    <Version>0.1.0</Version>
    <Description>Application identity, lifecycle reconciliation and native Windows application management.</Description>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IsPackable Condition="'$(SdkNativeRuntimeAssets)' == ''">false</IsPackable>
    <PublishRepositoryUrl>false</PublishRepositoryUrl>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../../../LICENSE" Pack="true" PackagePath="/" />
    <InternalsVisibleTo Include="DesktopApplications.Tests" />
    <None Include="$(SdkNativeRuntimeAssets)/**/*" Condition="'$(SdkNativeRuntimeAssets)' != ''"
          Pack="true" PackagePath="runtimes/%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="$(DesktopApplicationsNativeLibrary)" Condition="'$(DesktopApplicationsNativeLibrary)' != ''"
          CopyToOutputDirectory="Always" Pack="false">
      <Link Condition="'$(OS)' == 'Windows_NT'">desktop_applications.dll</Link>
      <Link Condition="'$(OS)' != 'Windows_NT'">libdesktop_applications.dylib</Link>
    </None>
    <None Include="../../README.md" Pack="true" PackagePath="/README.md" />
    <None Include="../../../../ThirdParty/**/*" Exclude="../../../../ThirdParty/**/.DS_Store;../../../../ThirdParty/**/registry-notices.json" Pack="true" PackagePath="licenses/" />
  </ItemGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PathMap>$(MSBuildProjectDirectory)=/desktop-applications/bindings/dotnet/src/$(MSBuildProjectName)</PathMap>
  </PropertyGroup>
</Project>
